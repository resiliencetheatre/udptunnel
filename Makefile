INCLUDE = -I./include
CC = gcc
#CC = /home/felipe/Sources/OpenWrt-SDK-brcm47xx-2.6-for-Linux-i686/staging_dir_mipsel/bin/mipsel-linux-gcc
CFLAGS = -Wall
LDLIBS = -lcrypto

all: utun-node legacy

utun-node: node.o mesh.o socket.o tun.o log.o ini.o
	$(CC) $(CFLAGS) $^ -o $@ $(LDLIBS)

node.o: node.c include/utun/mesh.h include/utun/tun.h
	$(CC) $(CFLAGS) $(INCLUDE) -c $<

mesh.o: mesh.c include/utun/mesh.h include/utun/socket.h ini.h
	$(CC) $(CFLAGS) $(INCLUDE) -c $<

legacy: socket.o tun.o util.o client.o server.o binn.o log.o ini.o
	$(CC) socket.o tun.o util.o client.o binn.o log.o ini.o -o client $(LDLIBS)
	$(CC) socket.o tun.o util.o server.o binn.o log.o ini.o -o server $(LDLIBS)

socket.o: socket.c include/utun/socket.h include/utun/tunnel_packet.h
	$(CC) $(CFLAGS) $(INCLUDE) -c $<

tun.o: tun.c
	$(CC) $(CFLAGS) $(INCLUDE) -c $<

util.o: util.c
	$(CC) $(CFLAGS) $(INCLUDE) -c $<

client.o: client.c
	$(CC) $(CFLAGS) $(INCLUDE) -c $<

server.o: server.c
	$(CC) $(CFLAGS) $(INCLUDE) -c $<

binn.o: binn.c
	$(CC) $(CFLAGS) $(INCLUDE) -c $<

log.o: log.c
	$(CC) $(CFLAGS) $(INCLUDE) -c $<

ini.o: ini.c
	$(CC) $(CFLAGS) $(INCLUDE) -c $<
clean:
	rm -f *.o utun-node node client server tests/test_transport tests/test_transport_sanitize tests/test_mesh tests/test_mesh_sanitize

# -----------------------------------------------------------
# Install and uninstall
# -----------------------------------------------------------

PREFIX ?= /usr/local
BINDIR = $(PREFIX)/bin

install: all
	install -d $(DESTDIR)$(BINDIR)
	install -m 0755 utun-node $(DESTDIR)$(BINDIR)/
	install -m 0755 server  $(DESTDIR)$(BINDIR)/
	install -m 0755 client $(DESTDIR)$(BINDIR)/

uninstall:
	rm -f $(DESTDIR)$(BINDIR)/utun-node
	rm -f $(DESTDIR)$(BINDIR)/server
	rm -f $(DESTDIR)$(BINDIR)/client

.PHONY: all clean install uninstall

TEST_BIN = tests/test_transport
$(TEST_BIN): tests/test_transport.c socket.c log.c include/utun/socket.h include/utun/tunnel_packet.h
	$(CC) $(CFLAGS) $(INCLUDE) tests/test_transport.c socket.c log.c -o $@ $(LDLIBS)

tests/test_mesh: tests/test_mesh.c mesh.c socket.c log.c ini.c include/utun/mesh.h
	$(CC) $(CFLAGS) $(INCLUDE) tests/test_mesh.c mesh.c socket.c log.c ini.c -o $@ $(LDLIBS)

test: $(TEST_BIN) tests/test_mesh utun-node
	./$(TEST_BIN)
	python3 tests/test_bundles.py

sanitize: utun-node
	$(CC) -Wall -g -fsanitize=address,undefined $(INCLUDE) tests/test_transport.c socket.c log.c -o tests/test_transport_sanitize $(LDLIBS)
	./tests/test_transport_sanitize
	$(CC) -Wall -g -fsanitize=address,undefined $(INCLUDE) tests/test_mesh.c mesh.c socket.c log.c ini.c -o tests/test_mesh_sanitize $(LDLIBS)
	python3 tests/test_bundles.py tests/test_mesh_sanitize

.PHONY: test sanitize

# Portable test bundles (Python 3 supplies native binary long counters).
legacy-test-bundles:
	@echo 'WARNING: /dev/urandom key material generated by this target is for testing only; do not use these bundles in real life.'
	@set -eu; \
	command -v python3 >/dev/null; \
	rm -rf -- client-test server-test; \
	umask 077; \
	mkdir client-test server-test; \
	mkdir client-test/scripts server-test/scripts; \
	dd if=/dev/urandom of=client-test/out.key bs=1000000 count=10 iflag=fullblock; \
	dd if=/dev/urandom of=client-test/in.key bs=1000000 count=10 iflag=fullblock; \
	cp client-test/out.key server-test/in.key; \
	cp client-test/in.key server-test/out.key; \
	sed 's/^server_address=.*/server_address=[SERVER_IP]/' client.ini > client-test/client.ini; \
	cp server.ini server-test/server.ini; \
	python3 -c 'import pathlib, struct; [pathlib.Path(d, n).write_bytes(struct.pack("@l", 0)) for d in ("client-test", "server-test") for n in ("out.counter", "in.counter")]'; \
	install -m 0755 scripts/linux_client.sh client-test/scripts/linux_client.sh; \
	install -m 0755 scripts/linux_server.sh server-test/scripts/linux_server.sh
	@echo 'Test bundles ready. Replace [SERVER_IP] in client-test/client.ini before starting.'

.PHONY: test-bundles

# Regenerate complete test bundles, replacing previous generated state without prompting.
PEERS ?= 3
KEY_BYTES ?= 1000000
BUNDLE_DIR ?= mesh-test
TRANSPORT_NETWORK ?= 10.1.0.0/24
OVERLAY_NETWORK ?= 10.50.0.0/24
VPS_HOST ?= vps.example.net
WSS_PORT ?= 8444
WSS_BIND ?= 0.0.0.0
WG_PORT ?= 51872
WG_IFACE ?= wg1
WG_MTU ?= 1200
OTP_MTU ?= 1128
SERVER_WSTUNNEL_BIN ?= /usr/local/bin/wstunnel
CLIENT_WSTUNNEL_BIN ?= /usr/local/bin/wstunnel

test-bundles: mesh-test-bundles
mesh-test-bundles:
	python3 scripts/provision_mesh.py --peers "$(PEERS)" --key-bytes "$(KEY_BYTES)" --output "$(BUNDLE_DIR)" --transport-network "$(TRANSPORT_NETWORK)" --overlay-network "$(OVERLAY_NETWORK)" \
	  --vps-host "$(VPS_HOST)" --wg-interface "$(WG_IFACE)" --wss-port "$(WSS_PORT)" --wss-bind "$(WSS_BIND)" \
	  --wg-port "$(WG_PORT)" --wg-mtu "$(WG_MTU)" --mtu "$(OTP_MTU)" \
	  --server-wstunnel-bin "$(SERVER_WSTUNNEL_BIN)" --client-wstunnel-bin "$(CLIENT_WSTUNNEL_BIN)"

.PHONY: legacy legacy-test-bundles mesh-test-bundles

# Linux integration: disposable namespaces, real WireGuard and TUN devices.
# Requires iproute2, wireguard-tools, ping, unshare and nsenter.
NETWORK_PEERS ?= 3
test-network: utun-node
	python3 tests/test_mesh_network.py --peers "$(NETWORK_PEERS)"
.PHONY: test-network

# Exercise the generated WG keys/configs and wstunnel ExecStart commands over WSS.
test-wstunnel: utun-node
	python3 tests/test_mesh_network.py --wstunnel --peers "$(NETWORK_PEERS)"
.PHONY: test-wstunnel
